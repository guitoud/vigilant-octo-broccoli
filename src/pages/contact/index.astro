---
import Layout from "../../layouts/Layout.astro";
import { contactData } from "../../config/contact";
---

<Layout title="Contact — FO Com Supports BP" activePage="contact">
  <section class="contact-hero">
    <div>
      <div class="eyebrow">★ Nous joindre</div>
      <h1>
        Une question, une alerte,<br />un <em>témoignage</em>&nbsp;?
      </h1>
    </div>
    <p>
      {contactData.messageRelais} Toute communication reste confidentielle —
      c'est la règle syndicale.
    </p>
  </section>

  <div class="contact-grid">
    <form
      class="contact-form"
      action="mailto:contact@focom-supportsbanquepostale.fr"
      method="post"
      enctype="text/plain"
    >
      <div class="row">
        <div>
          <label for="name">Prénom & nom</label>
          <input id="name" name="name" type="text" placeholder="Marie Dupont" required />
        </div>
        <div>
          <label for="team">Équipe / périmètre</label>
          <input
            id="team"
            name="team"
            type="text"
            placeholder="Crédits & Recouvrements"
          />
        </div>
      </div>
      <div>
        <label for="email">Adresse e-mail</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="prénom.nom@laposte.fr"
          required
        />
      </div>
      <div>
        <label for="subject">Sujet</label>
        <input
          id="subject"
          name="subject"
          type="text"
          placeholder="Charge de travail, rémunération, télétravail…"
          required
        />
      </div>
      <div>
        <label for="message">Votre message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder="Je souhaite vous signaler que…"
          required></textarea>
      </div>
      <button class="btn" type="submit">Envoyer le message →</button>
      <div
        style="font-family:'Archivo Narrow',sans-serif;font-size:.7rem;text-transform:uppercase;letter-spacing:.14em;color:var(--fo-muted)"
      >
        Réponse sous 48 h ouvrées · Confidentiel
      </div>
    </form>

    <div>
      <div class="eyebrow">★ Vos représentants</div>
      <div class="reps" style="margin-top:.6rem">
        {
          contactData.representants.map((rep) => (
            <div class="reps-card">
              <div class="role">{rep.role}</div>
              <div class="nom">{rep.nom}</div>
            </div>
          ))
        }
      </div>

      <div class="perm">
        <div class="k">Permanence</div>
        <div class="v">{contactData.permanence}</div>
        <div class="k">Lieu</div>
        <div class="v">{contactData.lieu}</div>
        <div class="k">E-mail</div>
        <div class="v" style="font-size:.95rem">{contactData.email}</div>
      </div>
    </div>
  </div>
</Layout>

---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import PostCard from "../components/PostCard.astro";
import Pillar from "../components/Pillar.astro";

const allPosts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [featured, ...rest] = allPosts;
const recent = rest.slice(0, 3);
---

<Layout
  title="FO Com Supports Banque Postale — Le Bulletin"
  activePage="home"
>
  {featured && <Hero post={featured} />}

  <header class="section-head">
    <h2>À la une de cette édition</h2>
    <a href="/actualites" class="more">Toutes les actualités →</a>
  </header>

  <div class="post-grid">
    {recent.map((post) => <PostCard post={post} />)}
  </div>

  <Pillar />
</Layout>

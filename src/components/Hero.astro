---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../utils/format";
import Placeholder from "./Placeholder.astro";

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { title, date, category } = post.data;
const slug = post.id.replace(/\.md$/, "");
const lead =
  post.body?.split(/\n+/).find((line) => line.trim() && !line.startsWith("#"))?.slice(0, 320) ??
  "";
---

<section class="hero">
  <div>
    <div class="eyebrow">★ Une — Édito syndical</div>
    <h1>{title}</h1>
    <p class="hero-deck">{lead}</p>
    <div class="byline">
      — Section FO Com Supports BP · {formatDate(date)} · {category}
    </div>
    <p style="margin-top:1rem">
      <a href={`/actualites/${slug}`} class="back-link">Lire l'édito →</a>
    </p>
  </div>
  <div style="position:relative;aspect-ratio:4/5">
    <Placeholder
      title={title}
      category={category}
      date={date}
      slug={slug}
    />
  </div>
</section>

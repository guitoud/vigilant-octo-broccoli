---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../utils/format";
import Placeholder from "./Placeholder.astro";

interface Props {
  post: CollectionEntry<"posts">;
  excerpt?: string;
}
const { post, excerpt } = Astro.props;
const { title, date, category } = post.data;
const slug = post.id.replace(/\.md$/, "");
const computed =
  excerpt ??
  post.body?.split(/\n+/).find((line) => line.trim() && !line.startsWith("#"))?.slice(0, 220) ??
  "";
---

<article class="post-card">
  <a href={`/actualites/${slug}`} class="post-card-img">
    <Placeholder
      title={title}
      category={category}
      date={date}
      slug={slug}
    />
  </a>
  <div class="post-card-cat">{category}</div>
  <h3 class="post-card-title">
    <a href={`/actualites/${slug}`}>{title}</a>
  </h3>
  <p class="post-card-excerpt">{computed}</p>
  <div class="post-card-meta">
    {formatDate(date)} · <a href={`/actualites/${slug}`}>Lire l'article →</a>
  </div>
</article>
